rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isHardcodedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'm26101342@gmail.com' ||
        request.auth.token.email == 'ronalmaferreira04@icloud.com' ||
        request.auth.token.email == 'sumodemanga50@gmail.com' ||
        request.auth.token.email == 'suportecvlab@gmail.com'
      );
    }
    function isAdmin() { 
      return isSignedIn() && (
        isHardcodedAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      ); 
    }

    match /users/{userId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /generated_documents/{docId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /client_resumes/{docId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /staff_access_links/{linkId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    match /admin_settings/{settingId} {
      allow read, list: if true;
      allow write, create, update: if true;
    }

    match /admin_notes/{noteId} {
      allow read, list: if true;
      allow write, create, update, delete: if true;
    }

    match /mail/{mailId} {
      allow read, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /presence/{userId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    match /visitors/{visitorId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }
  }
}
